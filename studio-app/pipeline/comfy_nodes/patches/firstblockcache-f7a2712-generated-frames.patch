+    @staticmethod
+    def _generated_diff(current, previous, context, global_diff):
+        """Chain shots re-inject the overlap frames every step, which swamps the global mean. Decide on the
+        median video latent frame instead (a minority of reset frames cannot move the median), and require the
+        audio rows to be calm too. Logs the breakdown every step."""
+        layout = getattr(context, "layout_segments", None)
+        parts = {}
+        vid = None
+        if context.video_slice is not None and context.latent_frames:
+            a, b = context.video_slice
+            cv, pv = current[a:b], previous[a:b]
+            if cv.shape[0] % context.latent_frames == 0:
+                r = cv.shape[0] // context.latent_frames
+                num = (cv - pv).float().abs().reshape(context.latent_frames, r, -1).mean(dim=(1, 2))
+                den = pv.float().abs().reshape(context.latent_frames, r, -1).mean(dim=(1, 2)).clamp(min=1e-8)
+                per = (num / den)
+                vid = float(per.median().item())
+                parts["video_frames"] = [round(float(x), 3) for x in per.tolist()]
+        for start, stop, kind in (layout or []):
+            if kind == "audio":
+                parts["audio"] = float(((current[start:stop] - previous[start:stop]).float().abs().mean()
+                                        / previous[start:stop].float().abs().mean().clamp(min=1e-8)).item())
+        if vid is None:
+            return global_diff
+        d = max(vid, parts.get("audio", 0.0))
+        logging.info("FBC[generated] sigma %.3f global %.3f video-median %.3f audio %s frames %s", context.previous_sigma,
+                     global_diff, vid, "%.3f" % parts["audio"] if "audio" in parts else "-", parts.get("video_frames"))
+        return d
+
